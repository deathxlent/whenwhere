{
  "name": "extractevent",
  "version": "1.0.0",
  "description": "从HTML历史文档中提取事件并生成addDataTools兼容的JSON格式",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build-portable": "electron-builder --win portable"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.extractevent.app",
    "productName": "ExtractEvent",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "lib/**/*",
      "config.template.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "config.template.json",
        "to": "config.template.json"
      }
    ]
  }
}
